diff --git a/dm/host/native_display.h b/dm/host/native_display.h
new file mode 100644
--- /dev/null
+++ b/dm/host/native_display.h
@@ -0,0 +1,27 @@
+#pragma once
+#include <math.h>
+#include <stdlib.h>
+
+static inline int dm_display_valid(int width, int height) {
+    return width >= 64 && height >= 64 && width <= 16384 && height <= 16384;
+}
+static inline int dm_display_pixels(double width, double height, double scale, int *out_width, int *out_height) {
+    double w = width * scale, h = height * scale;
+    if (!isfinite(w) || !isfinite(h) || !isfinite(scale) || scale <= 0 ||
+        w < 64 || h < 64 || w > 16384 || h > 16384) return 0;
+    *out_width = (int)lround(w); *out_height = (int)lround(h);
+    return dm_display_valid(*out_width, *out_height);
+}
+static inline int dm_display_select(int enabled, int native_width, int native_height,
+                                    int legacy_width, int legacy_height, int *out_width, int *out_height) {
+    int native = enabled && dm_display_valid(native_width, native_height);
+    *out_width = native ? native_width : legacy_width;
+    *out_height = native ? native_height : legacy_height;
+    return native;
+}
+static inline int dm_native_display_requested(void) {
+    const char *value = getenv("DM_NATIVE_DISPLAY");
+    return value && atoi(value) != 0;
+}
+void dm_native_display_publish(int width, int height);
+int dm_native_display_read(int *width, int *height);
