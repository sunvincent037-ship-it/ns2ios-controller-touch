@@ -0,0 +1,21 @@
+#include <assert.h>
+#include <math.h>
+#include "native_display.h"
+
+int main(void) {
+    int w = 0, h = 0;
+    assert(dm_display_pixels(1210, 834, 2, &w, &h));
+    assert(w == 2420 && h == 1668);
+    assert(dm_display_select(1, w, h, 1920, 1080, &w, &h));
+    assert(w == 2420 && h == 1668);
+    assert(!dm_display_select(0, 2420, 1668, 1920, 1080, &w, &h));
+    assert(w == 1920 && h == 1080);
+    assert(!dm_display_select(1, 0, 1668, 1280, 720, &w, &h));
+    assert(w == 1280 && h == 720);
+    assert(!dm_display_pixels(1210, 834, NAN, &w, &h));
+    assert(!dm_display_pixels(0, 834, 2, &w, &h));
+    assert(!dm_display_pixels(100000, 834, 2, &w, &h));
+    assert(dm_display_pixels(1376, 1032, 2, &w, &h));
+    assert(w == 2752 && h == 2064);
+    return 0;
+}
diff --git a/dm/tools/tests/test_nvn_rec_blit_options.py b/dm/tools/tests/test_nvn_rec_blit_options.py
new file mode 100644
--- /dev/null
+++ b/dm/tools/tests/test_nvn_rec_blit_options.py
@@ -0,0 +1,96 @@
+"""Exercise actual deferred-copy producer/replay code without requiring a GPU."""
+from pathlib import Path
+import platform
+import re
+import subprocess
+import tempfile
+import unittest
+
+REPO = Path(__file__).resolve().parents[3]
+
+
+def fragments():
+    source = (REPO / "dm/gfx/nvn/nvn_rec.h").read_text()
+    methods, cases = [], []
+    for direction, operation in (("Buffer", "BT"), ("Texture", "TB")):
+        method = re.search(r"- \(void\)copyFrom" + direction + r":[^\n{]* options:\(MTLBlitOption\)\w+ \{[^}]*\}", source)
+        if not method:
+            raise AssertionError("Missing option-bearing copyFrom" + direction + " recorder selector")
+        case = re.search(r"case RO_C_COPY_" + operation + r"_OPT:.*?break;", source, re.S)
+        if not case:
+            raise AssertionError("Missing option-bearing " + operation + " replay")
+        methods.append(method.group())
+        cases.append(case.group())
+    enum = re.search(r"enum \{\s+RO_CB_NEW,.*?\};", source, re.S).group()
+    record = re.search(r"typedef struct \{ uint32_t op, nobj; uint64_t a\[15\]; \} rec_t;", source).group()
+    return enum, record, "\n".join(methods), "\n".join(cases)
+
+
+HARNESS = r'''
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#include <assert.h>
+#include <stdint.h>
+#include <string.h>
+ENUM
+RECORD
+static rec_t captured;
+static rec_t *rec_put(uint32_t op, uint32_t nobj) { memset(&captured, 0, sizeof captured); captured.op=op; captured.nobj=nobj; return &captured; }
+static uint64_t rec_obj(id object) { return object ? (uint64_t)(uintptr_t)CFBridgingRetain(object) : 0; }
+static id rec_id(uint64_t value) { return (__bridge id)(void *)(uintptr_t)value; }
+@interface Recorder : NSObject @end
+@implementation Recorder
+METHODS
+@end
+@interface Capture : NSObject { @public id source, destination; uint64_t args[14]; int calls; } @end
+@implementation Capture
+- (void)copyFromBuffer:(id)s sourceOffset:(NSUInteger)so sourceBytesPerRow:(NSUInteger)row sourceBytesPerImage:(NSUInteger)img sourceSize:(MTLSize)z toTexture:(id)d destinationSlice:(NSUInteger)sl destinationLevel:(NSUInteger)lv destinationOrigin:(MTLOrigin)o options:(MTLBlitOption)opt {
+    source=s; destination=d; calls++; uint64_t values[]={so,row,img,z.width,z.height,z.depth,sl,lv,o.x,o.y,o.z,opt}; memcpy(args,values,sizeof values);
+}
+- (void)copyFromTexture:(id)s sourceSlice:(NSUInteger)sl sourceLevel:(NSUInteger)lv sourceOrigin:(MTLOrigin)o sourceSize:(MTLSize)z toBuffer:(id)d destinationOffset:(NSUInteger)off destinationBytesPerRow:(NSUInteger)row destinationBytesPerImage:(NSUInteger)img options:(MTLBlitOption)opt {
+    source=s; destination=d; calls++; uint64_t values[]={sl,lv,o.x,o.y,o.z,z.width,z.height,z.depth,off,row,img,opt}; memcpy(args,values,sizeof values);
+}
+@end
+static void replay(id e) {
+    const uint64_t *a=captured.a;
+    switch (captured.op) { CASES default: assert(0); }
+    for (uint32_t i=0;i<captured.nobj;i++) if(a[i]) CFRelease((CFTypeRef)(uintptr_t)a[i]);
+}
+int main(void) { @autoreleasepool {
+    Recorder *r=[Recorder new];
+    for (int direction=0;direction<2;direction++) for(int plane=0;plane<2;plane++) {
+        MTLBlitOption option=plane ? MTLBlitOptionStencilFromDepthStencil : MTLBlitOptionDepthFromDepthStencil;
+        id s=[NSObject new], d=[NSObject new]; __weak id ws=s, wd=d;
+        MTLOrigin origin=MTLOriginMake(7,8,9); MTLSize size=MTLSizeMake(101,102,3);
+        uint64_t offset=0x100000003ull,row=0x100000007ull,img=0x200000009ull;
+        if(direction==0) [r copyFromBuffer:s sourceOffset:offset sourceBytesPerRow:row sourceBytesPerImage:img sourceSize:size toTexture:d destinationSlice:11 destinationLevel:2 destinationOrigin:origin options:option];
+        else [r copyFromTexture:s sourceSlice:11 sourceLevel:2 sourceOrigin:origin sourceSize:size toBuffer:d destinationOffset:offset destinationBytesPerRow:row destinationBytesPerImage:img options:option];
+        assert(captured.nobj==2); assert(rec_id(captured.a[0])==s && rec_id(captured.a[1])==d);
+        s=nil;d=nil;assert(ws && wd);
+        Capture *capture=[Capture new]; replay(capture); assert(capture->calls==1 && capture->source==ws && capture->destination==wd);
+        uint64_t bt[]={offset,row,img,101,102,3,11,2,7,8,9,option};
+        uint64_t tb[]={11,2,7,8,9,101,102,3,offset,row,img,option};
+        assert(!memcmp(capture->args,direction ? tb : bt,sizeof bt));
+    }
+    puts("Deferred option-bearing copies preserve objects, depth/stencil selection and every 64-bit argument");
+} return 0; }
+'''
+
+
+class DeferredBlitOptions(unittest.TestCase):
+    def test_both_option_selectors_have_record_and_replay(self):
+        fragments()
+
+    @unittest.skipUnless(platform.system() == "Darwin", "Requires the Apple Metal SDK")
+    def test_actual_producer_replay_preserves_arguments_and_lifetime(self):
+        enum, record, methods, cases = fragments()
+        source = HARNESS.replace("ENUM", enum).replace("RECORD", record).replace("METHODS", methods).replace("CASES", cases)
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory); code=root/"test.m"; binary=root/"test"
+            code.write_text(source)
+            subprocess.run(["xcrun", "clang", "-fobjc-arc", "-Wno-unguarded-availability-new", "-framework", "Foundation", "-framework", "Metal", str(code), "-o", str(binary)], check=True)
+            subprocess.run([str(binary)], check=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
